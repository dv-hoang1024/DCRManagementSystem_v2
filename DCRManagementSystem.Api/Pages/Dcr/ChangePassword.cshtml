@page "/ChangePassword"
@model DCRManagementSystem.Api.Pages.Dcr.ChangePasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đổi mật khẩu DCR";
}

<div class="dcr-page dcr-password-page">
    <header class="dcr-topbar">
        <div>
            <div class="dcr-eyebrow">BẢO MẬT TÀI KHOẢN</div>
            <h1>Đổi mật khẩu DCR</h1>
            <p>@Model.CurrentUser?.FullName · @Model.CurrentUser?.Username</p>
        </div>
        <div class="dcr-topbar-actions">
            <a class="dcr-btn dcr-btn--secondary" href="/">← Danh sách DCR</a>
            <a class="dcr-btn dcr-btn--ghost" href="/Logout">Đăng xuất</a>
        </div>
    </header>

    <section class="dcr-panel dcr-password-card">
        <div class="dcr-panel-title"><span>Mật khẩu đăng nhập DCR</span><span>@Model.AuthMethod</span></div>
        <div class="dcr-panel-body">
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="dcr-alert dcr-alert--danger">@Model.ErrorMessage</div>
            }

            <div class="dcr-login-help">
                Thao tác này chỉ thay đổi mật khẩu nội bộ của DCR Management System, không thay đổi mật khẩu Windows,
                Active Directory hoặc LDAP. Sau khi đổi thành công, bạn sẽ được yêu cầu đăng nhập lại.
            </div>

            <form method="post" class="dcr-form dcr-password-form">
                <label>
                    <span>Mật khẩu DCR hiện tại *</span>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
                </label>
                <label>
                    <span>Mật khẩu mới *</span>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="8" required />
                    <small>Tối thiểu 8 ký tự và phải khác mật khẩu hiện tại.</small>
                </label>
                <label>
                    <span>Nhập lại mật khẩu mới *</span>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required />
                </label>
                <div class="dcr-inline-actions">
                    <button class="dcr-btn dcr-btn--primary" type="submit">Đổi mật khẩu</button>
                    <a class="dcr-btn dcr-btn--secondary" href="/">Hủy</a>
                </div>
            </form>
        </div>
    </section>
</div>
